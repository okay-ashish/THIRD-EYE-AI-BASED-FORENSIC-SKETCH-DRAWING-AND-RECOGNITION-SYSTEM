# =================================================================
# ThirdEye — Environment Configuration Template
# =================================================================
# Copy this file to .env and configure the values for your machine:
#   copy .env.example .env
#
# DO NOT share or commit .env containing real passwords or secrets.
# =================================================================

# Runtime Mode ('development' or 'production')
# In 'production', THIRDEYE_SECRET_KEY MUST be a non-empty random secret.
FLASK_ENV=development
THIRDEYE_COOKIE_SECURE=false

# Flask Application Secret Key (generate a secure random hex string for production)
# Example generator: python -c "import secrets; print(secrets.token_hex(32))"
THIRDEYE_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET

# MySQL Database Configuration (requires MySQL 8.0+ or MariaDB 10.4+)
THIRDEYE_DB_HOST=127.0.0.1
THIRDEYE_DB_PORT=3306
THIRDEYE_DB_USER=root
THIRDEYE_DB_PASSWORD=CHANGE_ME
THIRDEYE_DB_NAME=thirdeye_db

# Initial Administrator Account (optional, used by `flask init-db` or `python create_admin.py`)
# THIRDEYE_ADMIN_USER=admin
# THIRDEYE_ADMIN_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# Optional: Direct SQLAlchemy URI Override (takes precedence over THIRDEYE_DB_* vars)
# SQLALCHEMY_DATABASE_URI=mysql+mysqlconnector://root:password@127.0.0.1:3306/thirdeye_db
